# MCP server environment template (supabase/functions/mcp)
#
# Used ONLY by the MCP server, not by the terminal UI.
# Copy this file to supabase/functions/.env (git-ignored) and fill it in:
#   cp supabase/functions/.env.example supabase/functions/.env
#   supabase functions serve mcp --env-file supabase/functions/.env
# For the hosted project, set the same names with:
#   supabase secrets set MCP_SECRET=... OWNER_USER_ID=...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
# by Supabase automatically, locally and hosted. Don't set them here.
#
# Never put real values in this file. It's committed.

# [SECRET] The last part of the MCP URL: .../functions/v1/mcp/<MCP_SECRET>.
# Anyone with this value can read and edit your tasks through Claude.
# Generate 32 random bytes (64 hex characters) with a cryptographic RNG.
# Use a different value locally and in production.
#   Linux / macOS / Git Bash:  openssl rand -hex 32
#   PowerShell 7:              [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
MCP_SECRET=

# The Supabase Auth user whose tasks the MCP server reads and writes. Every
# query is pinned to this ID, because the service role bypasses RLS.
#   Local:  00000000-0000-0000-0000-000000000001  (the user created by supabase/seed.sql)
#   Hosted: Supabase dashboard > Authentication > Users > your user > copy the UID
OWNER_USER_ID=
