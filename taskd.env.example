# Terminal UI config template (cmd/taskd)
#
# Used ONLY by the terminal UI, not by the MCP server. The TUI talks to
# Supabase directly, so it needs its own URL, key and user ID.
#
# The TUI reads these as environment variables when it starts:
#   Linux:   copy this file to ~/.config/taskd/env (permissions 600) and load
#            it from ~/.bashrc. See the README's "Terminal UI" section.
#   Windows: set them as user environment variables with PowerShell. See the
#            README's "Terminal UI" section.
#
# Never put real values in this file. It's committed.
#
# The TUI checks these when it starts. It refuses an http:// URL (except
# 127.0.0.1 / localhost) and a user ID that isn't a UUID.

# Your project's API URL. Not a secret.
#   Hosted: https://<project-ref>.supabase.co
#           (dashboard > Project Settings > Data API > Project URL)
#   Local:  http://127.0.0.1:54321  (the API URL shown by `supabase status`)
export TASKD_SUPABASE_URL=""

# [SECRET] A key that can read the tasks table. Until OTP login lands, this
# is a service role or secret key, which BYPASSES RLS, so treat it like a
# root password.
#   Hosted, recommended: dashboard > Project Settings > API Keys > create a
#           new secret key just for the TUI (starts with sb_secret_). You can
#           revoke it on its own without breaking the MCP server.
#   Hosted, alternative: the legacy service_role key (starts with eyJ) on
#           the "Legacy API keys" tab.
#   Local:  the secret / service_role key printed by `supabase status`.
export TASKD_SERVICE_ROLE_KEY=""

# Your Supabase Auth user ID. Every TUI query is filtered to this user.
# Usually the same value as OWNER_USER_ID in supabase/functions/.env.
#   Hosted: dashboard > Authentication > Users > your user > copy the UID
#   Local:  00000000-0000-0000-0000-000000000001
export TASKD_USER_ID=""
